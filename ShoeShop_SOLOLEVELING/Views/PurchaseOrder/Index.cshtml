@model IEnumerable<ShoeShop.Services.DTOs.PurchaseOrderDto>

@{
    ViewData["Title"] = "Purchase Orders";
}

<h1>Purchase Orders</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Purchase Order</a>
</p>

<table class="table table-striped table-bordered">
    <thead class="thead-dark">
        <tr>
            <th>Order ID</th>
            <th>Supplier</th>
            <th>Order Date</th>
            <th>Total Amount</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <tr>
                    <td>#@Html.DisplayFor(modelItem => item.Id)</td>
                    <td>@Html.DisplayFor(modelItem => item.SupplierName)</td>
                    <td>@item.OrderDate.ToString("yyyy-MM-dd")</td>
                    <td>$@item.TotalAmount.ToString("N2")</td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center">No purchase orders found.</td>
            </tr>
        }
    </tbody>
</table>